{
  "name": "modular-dispatch-dashboard",
  "version": "1.0.0",
  "description": "Transportation Dispatch Dashboard - Web Application",
  "type": "module",
  "homepage": "./",
  "scripts": {
    "dev": "npx http-server -p 3000 -o index.html",
    "start": "npx http-server -p 8080 -o index.html",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/tailwind-build.css -o dist/css/main.css --minify",
    "test": "echo 'Tests will be added in future versions'",
    "lint": "echo 'Linting with future ESLint setup'",
    "serve": "npx http-server -p 3000 -c-1"
  },
  "keywords": [
    "dispatch",
    "transportation",
    "dashboard",
    "modular",
    "javascript",
    "touch-interface",
    "fleet-management"
  ],
  "author": "Modular Architecture Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.6"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
